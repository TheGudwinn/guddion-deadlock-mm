{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "deadlock-mm",
  "version": "0.1.0",
  "identifier": "ru.guddion.deadlockmm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "deadlock-mm",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Deadlock mod manager",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": [
          "ru-RU",
          "en-US"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyMUVBMDA4MTM3N0QxREEKUldUYTBYY1RDS0FlWWoyNU9MMlFGL0RQeENOYnJ0cXJ5dlExL0xvTkw4TUVPMW1yemxmdXE3dk0K",
      "endpoints": [
        "https://github.com/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
